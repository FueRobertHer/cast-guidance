# Security headers for static hosts that read a `_headers` file (Cloudflare
# Pages, Netlify). Vite copies public/ to dist/, so this ships with the build.
# Vercel ignores this file and applies vercel.json, which is the source of
# truth: keep the two identical (src/app/securityHeaders.test.ts checks).
# See docs/security-headers.md.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), microphone=(), payment=(), usb=()
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; img-src 'self' data:; font-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; worker-src 'self'; manifest-src 'self'; connect-src 'self' https://cdn.jsdelivr.net https://raw.githubusercontent.com https://api.github.com https://gist.githubusercontent.com

{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023"],
    "types": ["node"],
    "skipLibCheck": true,

    /* Bundler mode */
    "module": "nodenext",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Strictness (matches tsconfig.app.json) */
    "strict": true,
    "noUncheckedIndexedAccess": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": [
    "vite.config.ts",
    "scripts/bundleBudget.ts",
    "scripts/bundleBudget.test.ts",
    "scripts/bundle-budget.ts",
    "scripts/shippedModules.ts",
    "scripts/thirdPartyNotices.ts",
    "scripts/thirdPartyNotices.test.ts",
    "scripts/third-party-notices.ts",
    "scripts/generate-icons.ts",
    "scripts/iconSource.ts",
    "scripts/pwaManifest.test.ts",
    "pwa.manifest.ts"
  ]
}
